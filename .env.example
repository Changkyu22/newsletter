# 네이버 개발자 센터 (https://developers.naver.com) 에서 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Google Custom Search API (선택 — RSS 실패 시 대체)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# SMTP (사내 메일 서버)
SMTP_HOST=smtp.hanwha.internal
SMTP_PORT=587
SMTP_USERNAME=newsletter@hanwha.com
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=newsletter@hanwha.com
SMTP_SENDER_NAME=Hanwha Newsletter
SMTP_USE_TLS=true

# 뉴스 수집
NEWS_HOURS_LOOKBACK=24
NEWS_MAX_PER_KEYWORD=5
HTTP_TIMEOUT=15
HTTP_VERIFY_SSL=true

# 스케줄 (매일 08:00 KST)
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
SCHEDULE_TIMEZONE=Asia/Seoul
